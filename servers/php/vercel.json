{
  "version": 2,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/",
      "dest": "/api/displaymap.php"
    },
    {
      "src": "/displaymap.php",
      "dest": "/api/displaymap.php"
    },
    {
      "src": "/api/(.*\\.php)",
      "dest": "/api/$1"
    }
  ]
}
